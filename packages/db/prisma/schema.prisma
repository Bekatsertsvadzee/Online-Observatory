generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Contract: UserRole. Members must match contracts/openapi.yaml exactly.
enum UserRole {
  USER
  OPERATOR
}

enum AuthEventType {
  REGISTERED
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGGED_OUT
  RATE_LIMITED
}

enum ObservatoryStatus {
  ONLINE
  OFFLINE
  WEATHER_HOLD
  MAINTENANCE
}

enum EquipmentStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  FAULT
}

/// Contract: TargetType.
enum TargetType {
  MOON
  PLANET
  DOUBLE_STAR
  GLOBULAR_CLUSTER
  PLANETARY_NEBULA
  BRIGHT_NEBULA
}

enum VisibilityRating {
  EXCELLENT
  GOOD
  FAIR
  UNAVAILABLE
}

enum MissionState {
  REQUESTED
  SCHEDULED
  PREPARING
  SLEWING
  VERIFYING
  CENTERING
  OBSERVING
  CAPTURING
  PROCESSING
  COMPLETE
  WEATHER_HOLD
  NOT_VISIBLE
  HARDWARE_ERROR
  CANCELLED
  FAILED
}

/// Contract: MissionEventSource.
/// Contract: MissionFailureReason. Detail carried alongside a failure state.
enum MissionFailureReason {
  PLATE_SOLVE_FAILED
  SLEW_TIMEOUT
  CENTERING_ITERATIONS_EXHAUSTED
  TRACKING_LOST
  MOUNT_FAULT
  CAMERA_FAULT
  FOCUSER_FAULT
  AGENT_LINK_LOST
  HEARTBEAT_LOST
  SAFETY_REFUSED
  SAFETY_ENVELOPE_UNMEASURED
  TARGET_SET_BELOW_LIMIT
  WEATHER_UNSAFE
  SESSION_EXPIRED
  OPERATOR_ABORT
  CUSTOMER_CANCELLED
  PAYMENT_FAILED
}

enum MissionEventSource {
  CLOUD
  AGENT
  OPERATOR
}

enum MissionSharingMode {
  PRIVATE
  PUBLIC
}

enum MissionJoinPolicy {
  DISABLED
  OPEN
}

enum MissionParticipantStatus {
  JOINED
  LEFT
}

enum CaptureAccessStatus {
  AVAILABLE
  SAVED
  REVOKED
}

/// Contract: BookingStatus.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum ProcessingPreset {
  NATURAL
  BRIGHT
  DETAIL
}

/// Contract: CaptureVisibility. GALLERY is the only sharing state in Phase 1.
enum CaptureVisibility {
  PRIVATE
  GALLERY
}

enum CollectionKind {
  SOLAR_SYSTEM
  MESSIER_STARTER
  DEEP_SKY
  CUSTOM
}

enum SubscriptionPlan {
  OBSERVER
  EXPLORER
  ADVANCED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum CreditLedgerReason {
  SUBSCRIPTION_GRANT
  MISSION_DEBIT
  PRIVATE_SESSION_DEBIT
  REFUND
  ADJUSTMENT
}

enum PrivateSessionStatus {
  REQUESTED
  CONFIRMED
  ACTIVE
  COMPLETE
  CANCELLED
}

enum ObservatoryCommandOperation {
  START_MISSION
  ABORT_MISSION
  PARK
  CAPTURE
}

enum ObservatoryCommandStatus {
  RECEIVED
  AUTHORIZED
  EXECUTING
  COMPLETED
  REJECTED
  EXPIRED
  FAILED
}

/// Contract: AuditCategory.
enum AuditCategory {
  AUTH
  BOOKING
  PAYMENT
  MISSION
  COMMAND
  SAFETY
  OBSERVATORY_MODE
  OPERATOR_OVERRIDE
  AGENT_LINK
}

enum NetworkNodeKind {
  FIRST_PARTY
  PARTNER
}

enum NetworkNodeApprovalStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SUSPENDED
}

/// Contract: Locale.
enum Locale {
  en
  ka
}

/// Contract: Currency.
enum Currency {
  GEL
}

/// Contract: ObservatoryMode. SIMULATED is the default implementation, always.
enum ObservatoryMode {
  SIMULATED
  REAL
}

/// Contract: WeatherStatus.
enum WeatherStatus {
  CLEAR
  CLOUDY
  UNSAFE
  UNKNOWN
}

/// Contract: SessionRole. Exactly one CONTROLLER exists per mission at a time.
enum SessionRole {
  CONTROLLER
  OBSERVER
}

/// Contract: SlotUnavailableReason.
enum SlotUnavailableReason {
  ALREADY_BOOKED
  OUTSIDE_ASTRONOMICAL_DARKNESS
  WEATHER_HOLD
  OBSERVATORY_OFFLINE
  MAINTENANCE
  IN_THE_PAST
}

/// Contract: PaymentProvider. SANDBOX is never selectable in production.
enum PaymentProvider {
  SANDBOX
  BOG_IPAY
}

/// Contract: PaymentStatus.
enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// Contract: ImagingProfile.
enum ImagingProfile {
  LUNAR
  PLANETARY
  DOUBLE_STAR
  GLOBULAR_CLUSTER
  PLANETARY_NEBULA
  BRIGHT_NEBULA
}

/// Contract: OpticalConfig. Which optical train was actually in place.
enum OpticalConfig {
  F20_BARLOW
  F10_NATIVE
  F6_3_REDUCER
}

/// Contract: CaptureAssetKind.
enum CaptureAssetKind {
  IMAGE
  THUMBNAIL
  FITS
  UNMARKED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique
  name                String
  role                UserRole                 @default(USER)
  /// Contract: Locale. Darkview ships Georgian and English from the first commit,
  /// so every user has one and the contract User requires it.
  locale              Locale                   @default(en)
  emailVerifiedAt     DateTime?
  isDemo              Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  account             Account?
  sessions            Session[]
  verificationTokens  EmailVerificationToken[]
  missions            Mission[]
  bookings            Booking[]
  payments            Payment[]
  captures            Capture[]
  collections         Collection[]
  subscription        Subscription?
  creditLedger        CreditLedger[]
  privateSessions     PrivateSession[]
  observatoryCommands ObservatoryCommand[]
  auditLogs           AuditLog[]               @relation("AuditActor")
  missionPresences    MissionPresence[]
  missionParticipants MissionParticipant[]
  captureAccess       CaptureAccess[]
  networkNodes        ObservatoryNetworkNode[] @relation("NetworkNodeOwner")
}

model Account {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique
  csrfTokenHash String
  userId        String   @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimitBucket {
  key             String    @id
  count           Int
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model Observatory {
  id                  String                  @id @default(uuid()) @db.Uuid
  slug                String                  @unique
  nameEn              String
  nameKa              String
  city                String
  countryCode         String
  latitude            Float
  longitude           Float
  timezone            String
  status              ObservatoryStatus       @default(OFFLINE)
  /// Contract: ObservatoryMode. SIMULATED is the default implementation, always.
  /// REAL is reachable only through an explicit, attended operator action.
  mode                ObservatoryMode         @default(SIMULATED)
  isDemo              Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  telescopes          Telescope[]
  cameras             Camera[]
  compatibleTargets   TargetObservatory[]
  missions            Mission[]
  bookings            Booking[]
  captures            Capture[]
  privateSessions     PrivateSession[]
  observatoryCommands ObservatoryCommand[]
  safetyEnvelope      SafetyEnvelope?
  weatherState        WeatherState?
  networkNode         ObservatoryNetworkNode?
}

/// Contract: SafetyEnvelopeConfig. The numbers that stop the telescope destroying
/// itself. Every value here is measured or surveyed for one physical installation.
///
/// NOTHING IN THIS MODEL MAY CARRY A DEFAULT THAT WOULD LET AN UNMEASURED SYSTEM MOVE.
/// maxAltitudeDegrees is deliberately nullable with no default: null means UNMEASURED,
/// and while it is null both the cloud and the agent refuse every slew with
/// SAFETY_NOT_CONFIGURED. Setting it requires measuredAt and measuredBy.
model SafetyEnvelope {
  id                            String              @id @default(uuid()) @db.Uuid
  observatoryId                 String              @unique @db.Uuid
  minAltitudeDegrees            Float
  maxAltitudeDegrees            Float?
  maxAltitudeMeasuredAt         DateTime?
  maxAltitudeMeasuredBy         String?
  maxAltitudeMeasurementNote    String?
  sunExclusionDegrees           Float
  daylightLockSunAltitudeDegrees Float
  nudgeMaxDegrees               Float
  nudgeRateDegreesPerSecond     Float
  slewTimeoutSeconds            Int
  heartbeatLossSeconds          Int
  linkDeadSeconds               Int
  refocusTemperatureDeltaC      Float
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  observatory                   Observatory         @relation(fields: [observatoryId], references: [id], onDelete: Cascade)
  horizonMask                   HorizonMaskEntry[]
  forbiddenAzimuthSectors       AzimuthSector[]
}

/// Contract: HorizonMaskEntry. One bearing from the compass survey of the site.
model HorizonMaskEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  safetyEnvelopeId   String         @db.Uuid
  azimuthDegrees     Float
  minAltitudeDegrees Float
  safetyEnvelope     SafetyEnvelope @relation(fields: [safetyEnvelopeId], references: [id], onDelete: Cascade)

  @@unique([safetyEnvelopeId, azimuthDegrees])
}

/// Contract: AzimuthSector. Cable-wrap exclusion, inclusive start, exclusive end,
/// measured clockwise from north.
model AzimuthSector {
  id               String         @id @default(uuid()) @db.Uuid
  safetyEnvelopeId String         @db.Uuid
  fromDegrees      Float
  toDegrees        Float
  safetyEnvelope   SafetyEnvelope @relation(fields: [safetyEnvelopeId], references: [id], onDelete: Cascade)

  @@index([safetyEnvelopeId])
}

/// Contract: WeatherState. Phase 1 requires the manual operator hold; an automatic
/// sensor-driven hold is only used if a sensor is actually fitted.
model WeatherState {
  id            String        @id @default(uuid()) @db.Uuid
  observatoryId String        @unique @db.Uuid
  status        WeatherStatus @default(UNKNOWN)
  holdActive    Boolean       @default(false)
  note          String?
  setByUserId   String?       @db.Uuid
  updatedAt     DateTime      @updatedAt
  observatory   Observatory   @relation(fields: [observatoryId], references: [id], onDelete: Cascade)
}

model Telescope {
  id              String                   @id @default(uuid()) @db.Uuid
  observatoryId   String                   @db.Uuid
  name            String
  manufacturer    String
  model           String
  apertureMm      Int
  focalLengthMm   Int
  status          EquipmentStatus          @default(OFFLINE)
  isDemo          Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  observatory     Observatory              @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  cameras         Camera[]
  missions        Mission[]
  bookings        Booking[]
  captures        Capture[]
  privateSessions PrivateSession[]
  primaryForNodes ObservatoryNetworkNode[]

  @@unique([observatoryId, name])
  @@index([observatoryId, status])
}

model Camera {
  id            String          @id @default(uuid()) @db.Uuid
  observatoryId String          @db.Uuid
  telescopeId   String?         @db.Uuid
  name          String
  manufacturer  String
  model         String
  sensorType    String
  resolutionX   Int?
  resolutionY   Int?
  status        EquipmentStatus @default(OFFLINE)
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  observatory   Observatory     @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope     Telescope?      @relation(fields: [telescopeId], references: [id], onDelete: SetNull)

  @@unique([observatoryId, name])
  @@index([telescopeId])
}

model Target {
  id                                  String              @id @default(uuid()) @db.Uuid
  slug                                String              @unique
  catalogId                           String              @unique
  commonName                          String
  georgianName                        String
  type                                TargetType
  rightAscensionHours                 Float
  declinationDegrees                  Float
  magnitude                           Float
  angularSize                         String
  descriptionEn                       String
  descriptionKa                       String
  minimumAltitude                     Float
  preferredObservationDurationMinutes Int
  imagePreset                         String
  bestMonths                          Int[]
  currentVisibility                   VisibilityRating
  currentAltitude                     Float
  qualityScore                        Int
  isDemo                              Boolean             @default(false)
  createdAt                           DateTime            @default(now())
  updatedAt                           DateTime            @updatedAt
  compatibleObservatories             TargetObservatory[]
  bookings                            Booking[]
  missions                            Mission[]
  captures                            Capture[]

  @@index([type, currentVisibility, qualityScore])
}

model TargetObservatory {
  targetId      String      @db.Uuid
  observatoryId String      @db.Uuid
  isDemo        Boolean     @default(false)
  target        Target      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  observatory   Observatory @relation(fields: [observatoryId], references: [id], onDelete: Cascade)

  @@id([targetId, observatoryId])
  @@index([observatoryId])
}

model Mission {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  targetId            String               @db.Uuid
  observatoryId       String               @db.Uuid
  telescopeId         String               @db.Uuid
  state               MissionState         @default(REQUESTED)
  /// Contract: MissionFailureReason. Detail for a failure or hold state.
  failureReason       MissionFailureReason?
  sharingMode         MissionSharingMode   @default(PRIVATE)
  joinPolicy          MissionJoinPolicy    @default(DISABLED)
  allowSharedCaptures Boolean              @default(false)
  /// Contract: ObservatoryMode. A mission run against the simulator is permanently
  /// marked SIMULATED and is never presented as real telescope output.
  mode                ObservatoryMode      @default(SIMULATED)
  isDemo              Boolean              @default(false)
  requestedAt         DateTime             @default(now())
  scheduledFor        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  target              Target               @relation(fields: [targetId], references: [id], onDelete: Restrict)
  observatory         Observatory          @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope           Telescope            @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  events              MissionEvent[]
  captures            Capture[]
  booking             Booking?
  creditLedger        CreditLedger[]
  commands            ObservatoryCommand[]
  presences           MissionPresence[]
  participants        MissionParticipant[]
  captureAccess       CaptureAccess[]

  @@index([userId, requestedAt])
  @@index([observatoryId, state, scheduledFor])
  @@index([targetId])
  @@index([telescopeId])
}

model MissionPresence {
  id         String    @id @default(uuid()) @db.Uuid
  missionId  String    @db.Uuid
  userId     String    @db.Uuid
  lastSeenAt DateTime  @default(now())
  leftAt     DateTime?
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  mission    Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([missionId, leftAt, lastSeenAt])
}

model MissionParticipant {
  id              String                   @id @default(uuid()) @db.Uuid
  missionId       String                   @db.Uuid
  userId          String                   @db.Uuid
  status          MissionParticipantStatus @default(JOINED)
  canSaveCaptures Boolean                  @default(false)
  joinedAt        DateTime                 @default(now())
  leftAt          DateTime?
  isDemo          Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  mission         Mission                  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([missionId, status])
}

model MissionEvent {
  id         String             @id @default(uuid()) @db.Uuid
  missionId  String             @db.Uuid
  state      MissionState
  source     MissionEventSource
  message    String?
  occurredAt DateTime           @default(now())
  simulated  Boolean            @default(false)
  isDemo     Boolean            @default(false)
  mission    Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, occurredAt])
}

/// Contract: Booking. A slot is identified by its start instant and duration --
/// slots are generated (DV-054), not stored, so there is no Slot table.
///
/// Two CONFIRMED bookings may never occupy the same slot. Prisma cannot express a
/// partial unique index, so it is created as raw SQL in the migration:
///   booking_confirmed_slot_unique ON (observatoryId, slotStartAt) WHERE status = 'CONFIRMED'
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  targetId        String        @db.Uuid
  observatoryId   String        @db.Uuid
  telescopeId     String        @db.Uuid
  missionId       String?       @unique @db.Uuid
  paymentId       String?       @unique @db.Uuid
  slotStartAt     DateTime
  durationMinutes Int
  status          BookingStatus @default(PENDING_PAYMENT)
  priceMinor      Int
  currency        Currency      @default(GEL)
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  target          Target        @relation(fields: [targetId], references: [id], onDelete: Restrict)
  observatory     Observatory   @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope       Telescope     @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  mission         Mission?      @relation(fields: [missionId], references: [id], onDelete: SetNull)
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  privateSession  PrivateSession?

  @@index([observatoryId, slotStartAt])
  @@index([userId, slotStartAt])
  @@index([status])
}

/// Contract: PaymentIntent. No provider-specific column is modelled, because no
/// provider documentation has been confirmed yet (DV-056).
model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  amountMinor   Int
  currency      Currency        @default(GEL)
  providerRef   String?
  redirectUrl   String?
  failureReason String?
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  authorizedAt  DateTime?
  capturedAt    DateTime?
  refundedAt    DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking       Booking?

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status])
}

/// Contract: Capture. The frame metadata is what makes a capture evidence rather
/// than a picture: a capture produced by the simulator is permanently marked
/// SIMULATED and is never presented as telescope output.
model Capture {
  id                  String              @id
  userId              String              @db.Uuid
  missionId           String              @db.Uuid
  targetId            String              @db.Uuid
  observatoryId       String              @db.Uuid
  telescopeId         String              @db.Uuid
  capturedAt          DateTime
  imagingProfile      ImagingProfile
  opticalConfig       OpticalConfig
  exposureMilliseconds Float
  gain                Int
  framesStacked       Int
  integrationSeconds  Float
  widthPx             Int?
  heightPx            Int?
  solvedFocalLengthMm Float?
  fitsAvailable       Boolean             @default(false)
  processingPreset    ProcessingPreset
  visibility          CaptureVisibility   @default(PRIVATE)
  /// Contract: ObservatoryMode. Never defaulted to REAL.
  mode                ObservatoryMode     @default(SIMULATED)
  isDemo              Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  mission          Mission             @relation(fields: [missionId], references: [id], onDelete: Restrict)
  target           Target              @relation(fields: [targetId], references: [id], onDelete: Restrict)
  observatory      Observatory         @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope        Telescope           @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  collections         CollectionCapture[]
  access              CaptureAccess[]
  assets              CaptureAsset[]

  @@index([userId, capturedAt])
  @@index([missionId])
  @@index([targetId])
  @@index([observatoryId])
}

/// Contract: CaptureAssetKind. One stored object per kind. URLs are never public
/// bucket paths -- the API signs a short-expiry URL at request time.
model CaptureAsset {
  id          String           @id @default(uuid()) @db.Uuid
  captureId   String
  kind        CaptureAssetKind
  storageKey  String
  byteSize    Int?
  contentType String?
  createdAt   DateTime         @default(now())
  capture     Capture          @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@unique([captureId, kind])
}

model CaptureAccess {
  id        String              @id @default(uuid()) @db.Uuid
  captureId String
  missionId String              @db.Uuid
  userId    String              @db.Uuid
  status    CaptureAccessStatus @default(AVAILABLE)
  grantedAt DateTime            @default(now())
  savedAt   DateTime?
  isDemo    Boolean             @default(false)
  capture   Capture             @relation(fields: [captureId], references: [id], onDelete: Cascade)
  mission   Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([captureId, userId])
  @@index([missionId, userId, status])
}

model Collection {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  kind          CollectionKind
  nameEn        String
  nameKa        String
  descriptionEn String
  descriptionKa String
  isDemo        Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  captures      CollectionCapture[]

  @@unique([userId, kind])
  @@index([userId])
}

model CollectionCapture {
  collectionId String     @db.Uuid
  captureId    String
  addedAt      DateTime   @default(now())
  isDemo       Boolean    @default(false)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  capture      Capture    @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@id([collectionId, captureId])
  @@index([captureId])
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @db.Uuid
  plan      SubscriptionPlan
  status    SubscriptionStatus
  startsAt  DateTime
  endsAt    DateTime?
  isDemo    Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  missionId      String?            @db.Uuid
  amount         Int
  balanceAfter   Int
  reason         CreditLedgerReason
  idempotencyKey String             @unique
  note           String?
  isDemo         Boolean            @default(false)
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  mission        Mission?           @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([missionId])
}

model PrivateSession {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  observatoryId   String               @db.Uuid
  telescopeId     String               @db.Uuid
  bookingId       String?              @unique @db.Uuid
  durationMinutes Int
  startsAt        DateTime
  endsAt          DateTime
  status          PrivateSessionStatus @default(REQUESTED)
  isDemo          Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  observatory     Observatory          @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope       Telescope            @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  booking         Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([observatoryId, startsAt])
  @@index([userId, startsAt])
}

model ObservatoryCommand {
  id            String                      @id
  missionId     String                      @db.Uuid
  userId        String                      @db.Uuid
  observatoryId String                      @db.Uuid
  operation     ObservatoryCommandOperation
  status        ObservatoryCommandStatus    @default(RECEIVED)
  issuedAt      DateTime
  expiresAt     DateTime
  completedAt   DateTime?
  payload       Json?
  result        Json?
  simulated     Boolean                     @default(false)
  isDemo        Boolean                     @default(false)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  mission       Mission                     @relation(fields: [missionId], references: [id], onDelete: Restrict)
  user          User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  observatory   Observatory                 @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  auditLogs     AuditLog[]

  @@index([missionId, issuedAt])
  @@index([observatoryId, status, issuedAt])
  @@index([userId])
}

model AuditLog {
  id          String              @id @default(uuid()) @db.Uuid
  category    AuditCategory
  action      String
  actorUserId String?             @db.Uuid
  actorHash   String?
  entityType  String?
  entityId    String?
  commandId   String?
  metadata    Json?
  isDemo      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  actor       User?               @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  command     ObservatoryCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([commandId])
}

model ObservatoryNetworkNode {
  id                  String                      @id @default(uuid()) @db.Uuid
  ownerId             String                      @db.Uuid
  observatoryId       String                      @unique @db.Uuid
  primaryTelescopeId  String?                     @db.Uuid
  kind                NetworkNodeKind
  approvalStatus      NetworkNodeApprovalStatus   @default(DRAFT)
  capabilities        String[]
  approvedAt          DateTime?
  isDemo              Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  owner               User                        @relation("NetworkNodeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  observatory         Observatory                 @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  primaryTelescope    Telescope?                  @relation(fields: [primaryTelescopeId], references: [id], onDelete: SetNull)
  availabilityWindows NetworkAvailabilityWindow[]

  @@index([ownerId])
  @@index([approvalStatus, kind])
  @@index([primaryTelescopeId])
}

model NetworkAvailabilityWindow {
  id          String                 @id @default(uuid()) @db.Uuid
  nodeId      String                 @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  enabled     Boolean                @default(true)
  isDemo      Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  node        ObservatoryNetworkNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, weekday, startMinute, endMinute])
  @@index([nodeId, enabled, weekday])
}
