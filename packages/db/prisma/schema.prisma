generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Contract: UserRole. Members must match contracts/openapi.yaml exactly.
enum UserRole {
  USER
  OPERATOR
}

enum AuthEventType {
  REGISTERED
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGGED_OUT
  RATE_LIMITED
}

enum ObservatoryStatus {
  ONLINE
  OFFLINE
  WEATHER_HOLD
  MAINTENANCE
}

enum EquipmentStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  FAULT
}

/// Contract: TargetType.
enum TargetType {
  MOON
  PLANET
  DOUBLE_STAR
  GLOBULAR_CLUSTER
  PLANETARY_NEBULA
  BRIGHT_NEBULA
}

enum MissionState {
  REQUESTED
  SCHEDULED
  PREPARING
  SLEWING
  VERIFYING
  CENTERING
  OBSERVING
  CAPTURING
  PROCESSING
  COMPLETE
  WEATHER_HOLD
  NOT_VISIBLE
  HARDWARE_ERROR
  CANCELLED
  FAILED
}

/// Contract: MissionEventSource.
/// Contract: MissionFailureReason. Detail carried alongside a failure state.
enum MissionFailureReason {
  PLATE_SOLVE_FAILED
  SLEW_TIMEOUT
  CENTERING_ITERATIONS_EXHAUSTED
  TRACKING_LOST
  MOUNT_FAULT
  CAMERA_FAULT
  FOCUSER_FAULT
  AGENT_LINK_LOST
  HEARTBEAT_LOST
  SAFETY_REFUSED
  SAFETY_ENVELOPE_UNMEASURED
  TARGET_SET_BELOW_LIMIT
  WEATHER_UNSAFE
  SESSION_EXPIRED
  OPERATOR_ABORT
  CUSTOMER_CANCELLED
  PAYMENT_FAILED
}

enum MissionEventSource {
  CLOUD
  AGENT
  OPERATOR
}

enum MissionSharingMode {
  PRIVATE
  PUBLIC
}

enum MissionJoinPolicy {
  DISABLED
  OPEN
}

enum MissionParticipantStatus {
  JOINED
  LEFT
}

enum CaptureAccessStatus {
  AVAILABLE
  SAVED
  REVOKED
}

/// Contract: BookingStatus.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum ProcessingPreset {
  NATURAL
  BRIGHT
  DETAIL
}

/// Contract: CaptureVisibility. GALLERY is the only sharing state in Phase 1.
enum CaptureVisibility {
  PRIVATE
  GALLERY
}

enum CollectionKind {
  SOLAR_SYSTEM
  MESSIER_STARTER
  DEEP_SKY
  CUSTOM
}

enum SubscriptionPlan {
  OBSERVER
  EXPLORER
  ADVANCED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum CreditLedgerReason {
  SUBSCRIPTION_GRANT
  MISSION_DEBIT
  PRIVATE_SESSION_DEBIT
  REFUND
  ADJUSTMENT
  /// ADR-022, amended 2026-09-19: a period's unspent minutes, taken back at its end.
  EXPIRY
}

enum PrivateSessionStatus {
  REQUESTED
  CONFIRMED
  ACTIVE
  COMPLETE
  CANCELLED
}

/// Contract: CommandType. The complete set of instructions the cloud may send.
///
/// This row is the record of what actually crossed the process boundary, so it
/// carries the contract's vocabulary and not a second one of its own. The subset a
/// customer may cause to be minted is ClientCommandType, enforced in the API.
enum CommandType {
  GOTO
  NUDGE
  CAPTURE
  FOCUS
  ABORT
  PARK
  SET_PROFILE
}

enum ObservatoryCommandStatus {
  RECEIVED
  AUTHORIZED
  EXECUTING
  COMPLETED
  REJECTED
  EXPIRED
  FAILED
}

/// Contract: AuditCategory.
enum AuditCategory {
  AUTH
  BOOKING
  PAYMENT
  MISSION
  COMMAND
  SAFETY
  OBSERVATORY_MODE
  OPERATOR_OVERRIDE
  AGENT_LINK
  LOYALTY
  SUBSCRIPTION
}

enum NetworkNodeKind {
  FIRST_PARTY
  PARTNER
}

enum NetworkNodeApprovalStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  SUSPENDED
}

/// Contract: Locale.
enum Locale {
  en
  ka
}

/// Contract: Currency.
enum Currency {
  GEL
}

/// Contract: ObservatoryMode. SIMULATED is the default implementation, always.
enum ObservatoryMode {
  SIMULATED
  REAL
}

/// Contract: AgentPosture (ADR-024). Reported by the agent; the cloud only records it.
enum AgentPosture {
  SIMULATED
  ATTENDED
  UNATTENDED
  DISARMED
}

/// Contract: DisarmReason (ADR-024 §4).
enum DisarmReason {
  HARDWARE_FAULT
  PARK_FAILED
  LINK_LOST
  APPROVAL_WITHDRAWN
  LOCAL_DISARM
  SKY_SENSOR_STALE
}

/// Contract: WeatherStatus.
enum WeatherStatus {
  CLEAR
  CLOUDY
  UNSAFE
  UNKNOWN
}

/// Contract: SessionRole. Exactly one CONTROLLER exists per mission at a time.
enum SessionRole {
  CONTROLLER
  OBSERVER
}

/// Contract: SlotUnavailableReason.
enum SlotUnavailableReason {
  ALREADY_BOOKED
  OUTSIDE_ASTRONOMICAL_DARKNESS
  WEATHER_HOLD
  OBSERVATORY_OFFLINE
  MAINTENANCE
  IN_THE_PAST
}

/// Contract: PaymentProvider. SANDBOX is never selectable in production.
enum PaymentProvider {
  SANDBOX
  BOG_IPAY
}

/// Contract: PaymentStatus.
enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  BOOKING
  OBSERVER_PACK
  GIFT_VOUCHER
  SUBSCRIPTION
}

/// Contract: ObserverPackStatus.
enum ObserverPackStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

/// Contract: ImagingProfile.
enum ImagingProfile {
  LUNAR
  PLANETARY
  DOUBLE_STAR
  GLOBULAR_CLUSTER
  PLANETARY_NEBULA
  BRIGHT_NEBULA
}

/// Contract: TargetPositionSource.
enum TargetPositionSource {
  FIXED
  EPHEMERIS
}

/// Contract: SolarSystemBody. A body whose position is computed, never stored.
enum SolarSystemBody {
  MOON
  MERCURY
  VENUS
  MARS
  JUPITER
  SATURN
  URANUS
  NEPTUNE
}

/// Contract: OpticalConfig. Which optical train was actually in place.
enum OpticalConfig {
  F20_BARLOW
  F10_NATIVE
  F6_3_REDUCER
}

/// Contract: CaptureAssetKind.
enum CaptureAssetKind {
  IMAGE
  THUMBNAIL
  FITS
  UNMARKED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique
  name                String
  role                UserRole                 @default(USER)
  /// Contract: Locale. Darkview ships Georgian and English from the first commit,
  /// so every user has one and the contract User requires it.
  locale              Locale                   @default(en)
  emailVerifiedAt     DateTime?
  isDemo              Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  account             Account?
  sessions            Session[]
  verificationTokens  EmailVerificationToken[]
  missions            Mission[]
  bookings            Booking[]
  payments            Payment[]
  captures            Capture[]
  collections         Collection[]
  subscription        Subscription?
  creditAccount       CreditAccount?
  creditLedger        CreditLedger[]
  privateSessions     PrivateSession[]
  observatoryCommands ObservatoryCommand[]
  auditLogs           AuditLog[]               @relation("AuditActor")
  missionPresences    MissionPresence[]
  missionParticipants MissionParticipant[]
  missionSessions     MissionSession[]
  captureAccess       CaptureAccess[]
  networkNodes        ObservatoryNetworkNode[] @relation("NetworkNodeOwner")
  observerPacks       ObserverPack[]
  emailNotifications  EmailNotification[]
  bookingEntitlements BookingEntitlement[]
  giftVouchersBought  GiftVoucher[]            @relation("GiftVoucherBuyer")
  giftVouchersRedeemed GiftVoucher[]           @relation("GiftVoucherRedeemer")
  loyaltyAccount      LoyaltyAccount?
  loyaltyEntries      LoyaltyLedgerEntry[]
}

model Account {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique
  csrfTokenHash String
  userId        String   @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimitBucket {
  key             String    @id
  count           Int
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model Observatory {
  id                  String                  @id @default(uuid()) @db.Uuid
  slug                String                  @unique
  nameEn              String
  nameKa              String
  city                String
  countryCode         String
  latitude            Float
  longitude           Float
  timezone            String
  status              ObservatoryStatus       @default(OFFLINE)
  /// Contract: ObservatoryMode. SIMULATED is the default implementation, always.
  /// REAL is reachable only through an explicit, attended operator action.
  mode                ObservatoryMode         @default(SIMULATED)
  /// SHA-256 of the agent device token presented on the /ws/agent handshake.
  /// The token itself is never stored here and never logged: only the agent's
  /// mini-PC and cloud secret storage hold it. Null means no agent may connect.
  deviceTokenHash     String?                 @unique
  /// Set when the agent link drops or misses heartbeats past the threshold.
  linkLostAt          DateTime?
  /// The posture the agent last reported, in its hello or a heartbeat (ADR-024).
  /// Null until an agent has ever connected. Kept after the link drops: a node
  /// that disarmed stays unbookable until an agent reports otherwise.
  agentPosture        AgentPosture?
  /// Why it disarmed. Set only while agentPosture is DISARMED.
  agentDisarmReason   DisarmReason?
  isDemo              Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  telescopes          Telescope[]
  cameras             Camera[]
  compatibleTargets   TargetObservatory[]
  missions            Mission[]
  bookings            Booking[]
  captures            Capture[]
  privateSessions     PrivateSession[]
  observatoryCommands ObservatoryCommand[]
  safetyEnvelope      SafetyEnvelope?
  agentMessages       AgentMessage[]
  weatherState        WeatherState?
  networkNode         ObservatoryNetworkNode?
  viewingForecast     ViewingForecastHour[]
}

/// Contract: SafetyEnvelopeConfig. The numbers that stop the telescope destroying
/// itself. Every value here is measured or surveyed for one physical installation.
///
/// NOTHING IN THIS MODEL MAY CARRY A DEFAULT THAT WOULD LET AN UNMEASURED SYSTEM MOVE.
/// maxAltitudeDegrees is deliberately nullable with no default: null means UNMEASURED,
/// and while it is null both the cloud and the agent refuse every slew with
/// SAFETY_NOT_CONFIGURED. Setting it requires measuredAt and measuredBy.
model SafetyEnvelope {
  id                            String              @id @default(uuid()) @db.Uuid
  observatoryId                 String              @unique @db.Uuid
  minAltitudeDegrees            Float
  maxAltitudeDegrees            Float?
  maxAltitudeMeasuredAt         DateTime?
  maxAltitudeMeasuredBy         String?
  maxAltitudeMeasurementNote    String?
  sunExclusionDegrees           Float
  daylightLockSunAltitudeDegrees Float
  nudgeMaxDegrees               Float
  nudgeRateDegreesPerSecond     Float
  slewTimeoutSeconds            Int
  heartbeatLossSeconds          Int
  linkDeadSeconds               Int
  refocusTemperatureDeltaC      Float
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  observatory                   Observatory         @relation(fields: [observatoryId], references: [id], onDelete: Cascade)
  horizonMask                   HorizonMaskEntry[]
  forbiddenAzimuthSectors       AzimuthSector[]
}

/// Contract: HorizonMaskEntry. One bearing from the compass survey of the site.
model HorizonMaskEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  safetyEnvelopeId   String         @db.Uuid
  azimuthDegrees     Float
  minAltitudeDegrees Float
  safetyEnvelope     SafetyEnvelope @relation(fields: [safetyEnvelopeId], references: [id], onDelete: Cascade)

  @@unique([safetyEnvelopeId, azimuthDegrees])
}

/// Contract: AzimuthSector. Cable-wrap exclusion, inclusive start, exclusive end,
/// measured clockwise from north.
model AzimuthSector {
  id               String         @id @default(uuid()) @db.Uuid
  safetyEnvelopeId String         @db.Uuid
  fromDegrees      Float
  toDegrees        Float
  safetyEnvelope   SafetyEnvelope @relation(fields: [safetyEnvelopeId], references: [id], onDelete: Cascade)

  @@index([safetyEnvelopeId])
}

/// Contract: WeatherState. Phase 1 requires the manual operator hold; an automatic
/// sensor-driven hold is only used if a sensor is actually fitted.
model WeatherState {
  id            String        @id @default(uuid()) @db.Uuid
  observatoryId String        @unique @db.Uuid
  status        WeatherStatus @default(UNKNOWN)
  holdActive    Boolean       @default(false)
  note          String?
  setByUserId   String?       @db.Uuid
  updatedAt     DateTime      @updatedAt
  observatory   Observatory   @relation(fields: [observatoryId], references: [id], onDelete: Cascade)
}

/// Contract: ForecastSource (DV-110).
enum ForecastSource {
  METEOBLUE
  OPEN_METEO
}

/// DV-110. One forecast hour at one observatory, as the latest successful fetch
/// left it. Advisory only: nothing here sets or clears WeatherState.holdActive.
///
/// A fetch overwrites the hours it covers; a failed fetch writes nothing, so its
/// hours age past the maximum and are reported UNKNOWN rather than kept as clear.
model ViewingForecastHour {
  id                              String         @id @default(uuid()) @db.Uuid
  observatoryId                   String         @db.Uuid
  /// The instant the hour begins, on the hour.
  at                              DateTime
  source                          ForecastSource
  fetchedAt                       DateTime
  cloudCoverPercent               Float?
  cloudCoverLowPercent            Float?
  cloudCoverMidPercent            Float?
  cloudCoverHighPercent           Float?
  precipitationProbabilityPercent Float?
  relativeHumidityPercent         Float?
  windSpeedMetresPerSecond        Float?
  seeingArcseconds                Float?
  observatory                     Observatory    @relation(fields: [observatoryId], references: [id], onDelete: Cascade)

  @@unique([observatoryId, at])
}

/// Every message the agent sends carries a messageId. The agent replays its queue
/// after an outage, so the same message arrives more than once by design -- that is
/// the recovery path working, not a fault. Recording the id makes ingestion
/// idempotent: a replayed message is recognised and does not write a second row.
model AgentMessage {
  messageId     String      @id @db.Uuid
  observatoryId String      @db.Uuid
  type          String
  sentAt        DateTime
  receivedAt    DateTime    @default(now())
  observatory   Observatory @relation(fields: [observatoryId], references: [id], onDelete: Cascade)

  @@index([observatoryId, receivedAt])
}

model Telescope {
  id              String                   @id @default(uuid()) @db.Uuid
  observatoryId   String                   @db.Uuid
  name            String
  manufacturer    String
  model           String
  apertureMm      Int
  focalLengthMm   Int
  status          EquipmentStatus          @default(OFFLINE)
  isDemo          Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  observatory     Observatory              @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  cameras         Camera[]
  missions        Mission[]
  bookings        Booking[]
  captures        Capture[]
  privateSessions PrivateSession[]
  primaryForNodes ObservatoryNetworkNode[]

  @@unique([observatoryId, name])
  @@index([observatoryId, status])
}

model Camera {
  id            String          @id @default(uuid()) @db.Uuid
  observatoryId String          @db.Uuid
  telescopeId   String?         @db.Uuid
  name          String
  manufacturer  String
  model         String
  sensorType    String
  resolutionX   Int?
  resolutionY   Int?
  status        EquipmentStatus @default(OFFLINE)
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  observatory   Observatory     @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope     Telescope?      @relation(fields: [telescopeId], references: [id], onDelete: SetNull)

  @@unique([observatoryId, name])
  @@index([telescopeId])
}

/// Contract: Target. The Phase 1 catalogue is Build Plan section 01: twelve objects,
/// all confirmed to fit an available field of view and all bright enough for a
/// Bortle 8-9 sky.
///
/// Nothing here caches visibility. Both the contract and the Build Plan require
/// altitude, Sun angle and Moon separation to be computed at request time from live
/// ephemeris, never read from a stored column -- a target's observability changes
/// minute by minute, and a stored answer is wrong almost immediately.
model Target {
  id                      String                @id @default(uuid()) @db.Uuid
  slug                    String                @unique
  catalogId               String?               @unique
  nameEn                  String
  nameKa                  String
  type                    TargetType
  /// FIXED targets carry J2000 coordinates; EPHEMERIS targets carry a body and
  /// have their position computed at request time. Exactly one of the two below
  /// is set, which target_position_source_consistent enforces in the database.
  positionSource          TargetPositionSource
  rightAscensionHours     Float?
  declinationDegrees      Float?
  solarSystemBody         SolarSystemBody?
  angularSizeArcmin       Float
  magnitude               Float
  opticalConfig           OpticalConfig
  imagingProfile          ImagingProfile
  minAltitudeDegrees      Float
  expectedMissionMinutes  Int
  /// An image this telescope actually produced, or null. Never a stock image and
  /// never output from another instrument: the Build Plan requires the operator to
  /// photograph each target before it appears on the site.
  previewImageUrl         String?
  descriptionEn           String?
  descriptionKa           String?
  enabled                 Boolean               @default(true)
  isDemo                  Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  compatibleObservatories TargetObservatory[]
  bookings                Booking[]
  missions                Mission[]
  captures                Capture[]

  @@index([type, enabled])
}

model TargetObservatory {
  targetId      String      @db.Uuid
  observatoryId String      @db.Uuid
  isDemo        Boolean     @default(false)
  target        Target      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  observatory   Observatory @relation(fields: [observatoryId], references: [id], onDelete: Cascade)

  @@id([targetId, observatoryId])
  @@index([observatoryId])
}

model Mission {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  targetId            String               @db.Uuid
  observatoryId       String               @db.Uuid
  telescopeId         String               @db.Uuid
  state               MissionState         @default(REQUESTED)
  /// Contract: MissionFailureReason. Detail for a failure or hold state.
  failureReason       MissionFailureReason?
  sharingMode         MissionSharingMode   @default(PRIVATE)
  /// Contract: Mission.observable. DISABLED is not observable, OPEN is.
  ///
  /// ADR-007: sessions are private by default and become observable only when the
  /// controller opts in. This column is that opt-in. No separate `observable`
  /// boolean exists, because two columns meaning one thing can disagree.
  joinPolicy          MissionJoinPolicy    @default(DISABLED)
  /// ADR-007: observers receive no captures, and CaptureAccess stays frozen. This
  /// must remain false for every mission Phase 1 creates.
  allowSharedCaptures Boolean              @default(false)
  /// Contract: Mission.observerCapacity. Seats available to observers, over and
  /// above the one controller.
  ///
  /// ADR-007 caps it at five, and Mission_observer_capacity_within_adr007 makes
  /// that the database's rule rather than a number the application promises to
  /// check. The cap is per mission so an operator can lower it; nothing may raise
  /// it above five without amending the decision record.
  observerCapacity    Int                  @default(5)
  /// Contract: ObservatoryMode. A mission run against the simulator is permanently
  /// marked SIMULATED and is never presented as real telescope output.
  mode                ObservatoryMode      @default(SIMULATED)
  isDemo              Boolean              @default(false)
  requestedAt         DateTime             @default(now())
  scheduledFor        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  target              Target               @relation(fields: [targetId], references: [id], onDelete: Restrict)
  observatory         Observatory          @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope           Telescope            @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  events              MissionEvent[]
  captures            Capture[]
  booking             Booking?
  creditLedger        CreditLedger[]
  commands            ObservatoryCommand[]
  presences           MissionPresence[]
  participants        MissionParticipant[]
  observerPacks       ObserverPack[]
  captureAccess       CaptureAccess[]
  sessions            MissionSession[]
  auditLogs           AuditLog[]

  @@index([userId, requestedAt])
  @@index([observatoryId, state, scheduledFor])
  @@index([targetId])
  @@index([telescopeId])
}

/// Contract: MissionSession. Who currently holds the telescope.
///
/// `docs/ENGINEERING.md`: one active mission at a time, one active session owner at a time.
/// Both are partial unique indexes rather than application checks, because two
/// simultaneous requests cannot be separated by a read followed by a write. DV-058
/// creates them as raw SQL in the migration; Prisma cannot express either.
///
///   MissionSession_active_owner_unique  ON (missionId) WHERE revokedAt IS NULL
///   Mission_active_per_observatory_unique  ON (observatoryId) WHERE state is live
///
/// A session leaves the index the moment it is revoked, so handing the telescope to
/// the next customer is a status change and nothing more. Expiry is swept inside the
/// same transaction that opens the next session -- an index predicate cannot compare
/// against now().
model MissionSession {
  id         String    @id @default(uuid()) @db.Uuid
  missionId  String    @db.Uuid
  userId     String    @db.Uuid
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  /// Set when the session ends, expires, or is taken by an operator. Null means
  /// this row is the current owner, and the partial unique index above allows
  /// exactly one such row per mission.
  revokedAt  DateTime?
  /// Contract: CommandRejectionReason vocabulary is the agent's; this is for the
  /// operator reading the audit trail. Free text, never shown to a customer.
  revokedFor String?
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  mission    Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  commands   ObservatoryCommand[]

  @@index([missionId, issuedAt])
  @@index([userId, issuedAt])
  @@index([revokedAt, expiresAt])
}

model MissionPresence {
  id         String    @id @default(uuid()) @db.Uuid
  missionId  String    @db.Uuid
  userId     String    @db.Uuid
  lastSeenAt DateTime  @default(now())
  leftAt     DateTime?
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  mission    Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([missionId, leftAt, lastSeenAt])
}

model MissionParticipant {
  id              String                   @id @default(uuid()) @db.Uuid
  missionId       String                   @db.Uuid
  userId          String                   @db.Uuid
  status          MissionParticipantStatus @default(JOINED)
  canSaveCaptures Boolean                  @default(false)
  joinedAt        DateTime                 @default(now())
  leftAt          DateTime?
  isDemo          Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  mission         Mission                  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([missionId, status])
}

/// One purchased, view-only seat on somebody else's session (ADR-007, DV-102).
///
/// The pack is the sale and MissionParticipant is the attachment to it. They are
/// two tables because a seat outlives a connection: an observer whose phone drops
/// still owns what they paid for, and a seat that went back on sale the moment
/// they disconnected would let a sixth buyer take it while they reconnect.
///
/// Capacity is therefore counted here, over PENDING_PAYMENT and PAID rows, and
/// not over attached participants. There is no unique index behind that count --
/// "at most five rows" is not something an index can say -- so the mission row is
/// locked FOR UPDATE first, the same way takeObserverSeat does it.
model ObserverPack {
  id            String             @id @default(uuid()) @db.Uuid
  missionId     String             @db.Uuid
  userId        String             @db.Uuid
  paymentId     String?            @unique @db.Uuid
  status        ObserverPackStatus @default(PENDING_PAYMENT)
  /// When an unpaid hold lapses and the seat returns to the available count. Set
  /// for every PENDING_PAYMENT pack -- ObserverPack_pending_payment_has_hold_expiry
  /// makes that the database's rule, so an abandoned checkout cannot hold a seat
  /// for the length of a session.
  holdExpiresAt DateTime?
  priceMinor    Int
  currency      Currency           @default(GEL)
  isDemo        Boolean            @default(false)
  paidAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  mission       Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment       Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// One pack per person per mission. Buying twice is not two seats, and a second
  /// attempt while a hold is outstanding returns the first pack rather than opening
  /// another payment.
  @@unique([missionId, userId])
  @@index([missionId, status])
  @@index([status, holdExpiresAt])
}

/// Contract: MissionEvent. The mission's own trail -- one row per reported
/// transition, append-only, never edited and never backdated.
///
/// `occurredAt` is the observatory's clock for an agent-sourced event, replayed
/// unchanged after a reconnect. It is deliberately not the insert time: an event
/// rewritten to look contemporaneous is a fabricated timestamp.
///
/// `failureReason` and `commandId` are the event's own, not the mission's. The
/// mission carries only its latest failure; the trail has to show which transition
/// carried which reason, and which command caused it. Both arrive on
/// AgentMissionEvent and were discarded until DV-062.
model MissionEvent {
  id            String                @id @default(uuid()) @db.Uuid
  missionId     String                @db.Uuid
  state         MissionState
  failureReason MissionFailureReason?
  source        MissionEventSource
  commandId     String?               @db.Uuid
  message       String?
  occurredAt    DateTime              @default(now())
  simulated     Boolean               @default(false)
  isDemo        Boolean               @default(false)
  mission       Mission               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  command       ObservatoryCommand?   @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([missionId, occurredAt])
  @@index([commandId])
}

/// Contract: Booking. A slot is identified by its start instant and duration --
/// slots are generated (DV-054), not stored, so there is no Slot table.
///
/// Exclusivity is the database's job, not the application's. Prisma cannot express
/// a partial unique index, so DV-055 creates it as raw SQL in the migration:
///   booking_held_slot_unique ON (observatoryId, slotStartAt)
///     WHERE status IN ('PENDING_PAYMENT', 'CONFIRMED')
///
/// A booking holds its slot from the moment it is reserved, not from the moment it
/// is paid for -- otherwise two people could pay for the same half hour and only
/// one of them could have it. CANCELLED, EXPIRED and REFUNDED bookings fall out of
/// the index, so a released slot is immediately bookable again.
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  targetId        String        @db.Uuid
  observatoryId   String        @db.Uuid
  telescopeId     String        @db.Uuid
  missionId       String?       @unique @db.Uuid
  paymentId       String?       @unique @db.Uuid
  slotStartAt     DateTime
  durationMinutes Int
  status          BookingStatus @default(PENDING_PAYMENT)
  /// When an unpaid hold lapses and the slot returns to the available list. Set for
  /// every PENDING_PAYMENT booking -- booking_pending_payment_has_hold_expiry makes
  /// that the database's rule, so an abandoned checkout cannot hold a slot forever.
  holdExpiresAt   DateTime?
  priceMinor      Int
  currency        Currency      @default(GEL)
  /// Contract: the Idempotency-Key header on POST /bookings. Unique per user, so a
  /// retried request returns the first booking instead of reserving a second slot.
  /// Null for a request that sent no key; Postgres does not collide on nulls.
  idempotencyKey  String?
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  target          Target        @relation(fields: [targetId], references: [id], onDelete: Restrict)
  observatory     Observatory   @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope       Telescope     @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  mission         Mission?      @relation(fields: [missionId], references: [id], onDelete: SetNull)
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  privateSession  PrivateSession?
  /// DV-111. What this booking's slot entitles the customer to, once it has ended.
  entitlement     BookingEntitlement? @relation("BookingEntitlement")
  /// DV-111. Set on a free reschedule: the entitlement this booking was made from.
  rescheduledFrom BookingEntitlement? @relation("RescheduledTo")
  /// DV-112. The gift voucher that paid for this booking, when one did.
  redeemedVoucher GiftVoucher?
  /// DV-095. What the customer's tier took off the slot price, in minor units.
  tierDiscountMinor     Int @default(0)
  /// DV-095. Points spent on this booking, taken when the slot was held.
  loyaltyPointsRedeemed Int @default(0)
  /// ADR-022. Subscription minutes that paid for this booking, taken when it was made.
  subscriptionMinutesSpent Int @default(0)

  @@unique([userId, idempotencyKey])
  @@index([observatoryId, slotStartAt])
  @@index([userId, slotStartAt])
  @@index([status])
  @@index([status, holdExpiresAt])
}

/// Contract: PaymentIntent. No provider-specific column is modelled, because no
/// provider documentation has been confirmed yet (DV-056).
model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  /// What this payment buys. Not a contract field -- no client is told, and
  /// PaymentIntent is the same shape either way -- but the settlement path must
  /// know which record to apply an outcome to, and inferring that from whichever
  /// relation happens to be null would make a payment with neither look like a
  /// booking. Written once, by whichever path opens the intent, alongside the row
  /// it belongs to and in the same transaction; nothing updates it afterwards.
  purpose       PaymentPurpose  @default(BOOKING)
  provider      PaymentProvider
  status        PaymentStatus   @default(PENDING)
  amountMinor   Int
  currency      Currency        @default(GEL)
  providerRef   String?
  redirectUrl   String?
  failureReason String?
  isDemo        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  authorizedAt  DateTime?
  capturedAt    DateTime?
  refundedAt    DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking       Booking?
  observerPack  ObserverPack?
  giftVoucher   GiftVoucher?
  /// ADR-022. Set on a renewal charge. `Payment_subscription_period_live_key`, a
  /// partial unique index on (subscriptionId, periodStart) WHERE status <> 'FAILED',
  /// is what makes the sweep idempotent without leader election: two passes over
  /// one period open one live charge. A FAILED charge leaves the index, so the
  /// retry the grace period allows can open the next one (ADR-022, amended
  /// 2026-09-19). Raw SQL in the migration; Prisma cannot express it.
  subscriptionId String?       @db.Uuid
  periodStart    DateTime?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([subscriptionId, periodStart])
  @@index([userId, createdAt])
  @@index([status])
}

/// Contract: Capture. The frame metadata is what makes a capture evidence rather
/// than a picture: a capture produced by the simulator is permanently marked
/// SIMULATED and is never presented as telescope output.
model Capture {
  id                  String              @id
  userId              String              @db.Uuid
  missionId           String              @db.Uuid
  targetId            String              @db.Uuid
  observatoryId       String              @db.Uuid
  telescopeId         String              @db.Uuid
  /// The CAPTURE command that produced this frame.
  ///
  /// Two jobs, and both of them matter. It is the correlation key: MissionEvent
  /// and AuditLog already carry commandId, so without this the capture is the one
  /// artefact of a mission that cannot be traced back to the instruction that made
  /// it. And it is the idempotency key -- Capture_command_unique is what stops an
  /// agent that re-sends a capture creating a second row and a second copy in the
  /// customer's Collection.
  ///
  /// Nullable because a capture need not have come from a command the cloud minted
  /// -- an operator-side capture would not -- and because Postgres allows many
  /// NULLs under a unique index, which is the behaviour wanted here.
  commandId           String?             @db.Uuid
  capturedAt          DateTime
  imagingProfile      ImagingProfile
  opticalConfig       OpticalConfig
  exposureMilliseconds Float
  gain                Int
  framesStacked       Int
  integrationSeconds  Float
  widthPx             Int?
  heightPx            Int?
  solvedFocalLengthMm Float?
  fitsAvailable       Boolean             @default(false)
  processingPreset    ProcessingPreset
  visibility          CaptureVisibility   @default(PRIVATE)
  /// Contract: ObservatoryMode. Never defaulted to REAL.
  mode                ObservatoryMode     @default(SIMULATED)
  isDemo              Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  mission          Mission             @relation(fields: [missionId], references: [id], onDelete: Restrict)
  target           Target              @relation(fields: [targetId], references: [id], onDelete: Restrict)
  observatory      Observatory         @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope        Telescope           @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  collections         CollectionCapture[]
  access              CaptureAccess[]
  assets              CaptureAsset[]
  command             ObservatoryCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@unique([commandId], map: "Capture_command_unique")
  @@index([userId, capturedAt])
  @@index([missionId])
  @@index([targetId])
  @@index([observatoryId])
}

/// Contract: CaptureAssetKind. One stored object per kind. URLs are never public
/// bucket paths -- the API signs a short-expiry URL at request time.
model CaptureAsset {
  id          String           @id @default(uuid()) @db.Uuid
  captureId   String
  kind        CaptureAssetKind
  storageKey  String
  byteSize    Int?
  contentType String?
  createdAt   DateTime         @default(now())
  capture     Capture          @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@unique([captureId, kind])
}

model CaptureAccess {
  id        String              @id @default(uuid()) @db.Uuid
  captureId String
  missionId String              @db.Uuid
  userId    String              @db.Uuid
  status    CaptureAccessStatus @default(AVAILABLE)
  grantedAt DateTime            @default(now())
  savedAt   DateTime?
  isDemo    Boolean             @default(false)
  capture   Capture             @relation(fields: [captureId], references: [id], onDelete: Cascade)
  mission   Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([captureId, userId])
  @@index([missionId, userId, status])
}

model Collection {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  kind          CollectionKind
  nameEn        String
  nameKa        String
  descriptionEn String
  descriptionKa String
  isDemo        Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  captures      CollectionCapture[]

  @@unique([userId, kind])
  @@index([userId])
}

model CollectionCapture {
  collectionId String     @db.Uuid
  captureId    String
  addedAt      DateTime   @default(now())
  isDemo       Boolean    @default(false)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  capture      Capture    @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@id([collectionId, captureId])
  @@index([captureId])
}

/// ADR-022. One subscription per customer. The price is copied from the plan
/// catalogue when a period is charged, so a later change to the catalogue never
/// rewrites what somebody already paid.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  plan               SubscriptionPlan
  status             SubscriptionStatus
  startsAt           DateTime
  endsAt             DateTime?
  priceMinor         Int
  currency           Currency           @default(GEL)
  /// Null until the first period is paid: a subscription grants nothing before
  /// money arrives (ADR-022 section 6).
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// The customer asked to stop, but the period they paid for still runs.
  cancelAtPeriodEnd  Boolean            @default(false)
  pausedAt           DateTime?
  /// The provider's handle for the saved card. Never the card itself, and never
  /// something this platform could charge with on its own.
  providerMandateRef String?
  /// The most recent renewal payment. A scalar, not a relation: Payment already
  /// points here, and a second relation between the two would need naming for no
  /// gain.
  lastPaymentId      String?            @db.Uuid
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  renewalPayments    Payment[]

  @@index([status, currentPeriodEnd])
}

/// ADR-022. The plan catalogue, as rows rather than code, following LoyaltyScheme:
/// changing a price or withdrawing a plan is an UPDATE, not a deployment. Empty
/// until the maintainer sets prices, and an empty catalogue sells nothing.
model SubscriptionPlanConfig {
  plan             SubscriptionPlan @id
  nameEn           String
  nameKa           String
  priceMinor       Int
  currency         Currency         @default(GEL)
  /// Observation minutes granted when a period is paid. Minutes, not observations:
  /// the slot length is not settled until DV-035 measures the real optical train
  /// (ADR-022 section 2).
  minutesPerPeriod Int
  isAvailable      Boolean          @default(false)
  updatedAt        DateTime         @updatedAt
}

/// ADR-022. The denormalised balance behind CreditLedger, in observation minutes.
/// It changes only in the transaction that appends the entry, and a spend is a
/// conditional update on it rather than a row lock, so checkout does not serialise.
model CreditAccount {
  userId    String   @id @db.Uuid
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ADR-022. Append-only, in observation minutes, enforced by a trigger. Idempotent
/// by `idempotencyKey`, which names its source: `renewal:<subscriptionId>:<periodStart>`,
/// `booking:<bookingId>`, `booking:<bookingId>:release`,
/// `expiry:<subscriptionId>:<periodEnd>`, `admin:<auditEventId>`.
model CreditLedger {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  missionId      String?            @db.Uuid
  amount         Int
  balanceAfter   Int
  reason         CreditLedgerReason
  idempotencyKey String             @unique
  note           String?
  isDemo         Boolean            @default(false)
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  mission        Mission?           @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([missionId])
}

model PrivateSession {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  observatoryId   String               @db.Uuid
  telescopeId     String               @db.Uuid
  bookingId       String?              @unique @db.Uuid
  durationMinutes Int
  startsAt        DateTime
  endsAt          DateTime
  status          PrivateSessionStatus @default(REQUESTED)
  isDemo          Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  observatory     Observatory          @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  telescope       Telescope            @relation(fields: [telescopeId], references: [id], onDelete: Restrict)
  booking         Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([observatoryId, startsAt])
  @@index([userId, startsAt])
}

/// One minted CommandEnvelope, as a durable row.
///
/// ADR-009: the orchestrator writes this row and issues NOTIFY in the same
/// transaction; the realtime service reads it and sends it down the agent socket.
/// The row is the source of truth and the notification is only a wake-up, so a
/// notification lost while realtime was reconnecting costs latency, never a command.
///
/// `id` is the contract's `commandId`, which is also the agent's idempotency key --
/// hence a real UUID column. A value the agent's CommandEnvelope could not parse
/// must not be storable here.
model ObservatoryCommand {
  id            String                   @id @db.Uuid
  missionId     String                   @db.Uuid
  sessionId     String                   @db.Uuid
  userId        String                   @db.Uuid
  observatoryId String                   @db.Uuid
  type          CommandType
  status        ObservatoryCommandStatus @default(RECEIVED)
  issuedAt      DateTime
  expiresAt     DateTime
  /// When the realtime service put it on the wire. Null means it is still waiting,
  /// which is what the ADR-009 fallback sweep looks for.
  relayedAt     DateTime?
  completedAt   DateTime?
  /// The contract CommandPayload, exactly as sent. Never rebuilt from columns: the
  /// audit has to show what crossed the boundary, not an approximation of it.
  payload       Json?
  result        Json?
  simulated     Boolean                  @default(false)
  isDemo        Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  mission       Mission                  @relation(fields: [missionId], references: [id], onDelete: Restrict)
  session       MissionSession           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  observatory   Observatory              @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  auditLogs     AuditLog[]
  missionEvents MissionEvent[]
  captures      Capture[]

  @@index([missionId, issuedAt])
  @@index([observatoryId, status, issuedAt])
  @@index([observatoryId, relayedAt])
  @@index([userId])
}

/// Contract: AuditEvent. Append-only. Never edited, never backdated, never
/// fabricated.
///
/// `missionId` is a column rather than an `entityType`/`entityId` pair because
/// AuditEvent declares it and `GET /admin/logs?missionId=` filters on it. Reading a
/// mission's trail out of a polymorphic pair would mean a scan, and the one query
/// an operator runs during an incident is the one that must not be slow.
///
/// The mission relation is `SetNull`, not `Cascade`: deleting a mission must not
/// delete the account of what was done to it.
model AuditLog {
  id          String              @id @default(uuid()) @db.Uuid
  category    AuditCategory
  action      String
  actorUserId String?             @db.Uuid
  actorHash   String?
  entityType  String?
  entityId    String?
  missionId   String?             @db.Uuid
  commandId   String?             @db.Uuid
  metadata    Json?
  isDemo      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  actor       User?               @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  mission     Mission?            @relation(fields: [missionId], references: [id], onDelete: SetNull)
  command     ObservatoryCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([category, createdAt])
  @@index([entityType, entityId])
  @@index([missionId, createdAt])
  @@index([commandId])
}

model ObservatoryNetworkNode {
  id                  String                      @id @default(uuid()) @db.Uuid
  ownerId             String                      @db.Uuid
  observatoryId       String                      @unique @db.Uuid
  primaryTelescopeId  String?                     @db.Uuid
  kind                NetworkNodeKind
  approvalStatus      NetworkNodeApprovalStatus   @default(DRAFT)
  capabilities        String[]
  approvedAt          DateTime?
  isDemo              Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  owner               User                        @relation("NetworkNodeOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  observatory         Observatory                 @relation(fields: [observatoryId], references: [id], onDelete: Restrict)
  primaryTelescope    Telescope?                  @relation(fields: [primaryTelescopeId], references: [id], onDelete: SetNull)
  availabilityWindows NetworkAvailabilityWindow[]

  @@index([ownerId])
  @@index([approvalStatus, kind])
  @@index([primaryTelescopeId])
}

model NetworkAvailabilityWindow {
  id          String                 @id @default(uuid()) @db.Uuid
  nodeId      String                 @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  enabled     Boolean                @default(true)
  isDemo      Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  node        ObservatoryNetworkNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, weekday, startMinute, endMinute])
  @@index([nodeId, enabled, weekday])
}

enum EmailNotificationKind {
  BOOKING_CONFIRMED
  SLOT_REMINDER
  WEATHER_HOLD
  CAPTURE_READY
  ENTITLEMENT_AVAILABLE
  BOOKING_REFUNDED
  GIFT_VOUCHER_ISSUED
  GIFT_VOUCHER_RESTORED
  /// #123: a refund gave back the subscription minutes a booking spent.
  SUBSCRIPTION_MINUTES_RETURNED
}

/// Contract: BookingLossCause (DV-111).
enum BookingLossCause {
  WEATHER
  OBSERVATORY_FAULT
}

/// DV-111. NONE: the slot was evaluated and nothing was lost on our side, or less
/// than half of it -- recorded so the slot is never evaluated twice.
enum BookingEntitlementOutcome {
  NONE
  OPEN
  REFUNDED
  RESCHEDULED
}

/// DV-111. The result of evaluating one ended slot, written once.
///
/// Maintainer rules, 2026-09-15: a slot lost to weather or to our fault, where the
/// customer lost half the slot or more, entitles them to choose a full refund or a
/// free reschedule; a reschedule must be used within 30 days, after which the
/// entitlement becomes a refund.
model BookingEntitlement {
  id                   String                    @id @default(uuid()) @db.Uuid
  bookingId            String                    @unique @db.Uuid
  userId               String                    @db.Uuid
  outcome              BookingEntitlementOutcome
  cause                BookingLossCause?
  minutesLost          Int
  evaluatedAt          DateTime
  expiresAt            DateTime?
  resolvedAt           DateTime?
  rescheduledBookingId String?                   @unique @db.Uuid
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  booking              Booking                   @relation("BookingEntitlement", fields: [bookingId], references: [id], onDelete: Cascade)
  rescheduledBooking   Booking?                  @relation("RescheduledTo", fields: [rescheduledBookingId], references: [id], onDelete: SetNull)
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([outcome, expiresAt])
}

/// DV-112. EXPIRED is not stored: the contract reports an ACTIVE voucher past
/// expiresAt as EXPIRED, so nothing has to sweep the table for time to pass.
enum GiftVoucherStatus {
  PENDING_PAYMENT
  ACTIVE
  REDEEMED
  CANCELLED
}

/// DV-112. A gift voucher: one observation of `durationMinutes`, paid for once.
///
/// The code is never stored. It is derived from the id with VOUCHER_CODE_SECRET,
/// so the email can be written when the outbox is delivered; `codeHash` is what a
/// redemption looks up. Not exchangeable for cash: a refund of the booking it paid
/// for restores it (DV-111).
model GiftVoucher {
  id                String            @id @default(uuid()) @db.Uuid
  buyerUserId       String            @db.Uuid
  paymentId         String            @unique @db.Uuid
  codeHash          String            @unique
  codeLast4         String
  durationMinutes   Int
  priceMinor        Int
  currency          Currency          @default(GEL)
  status            GiftVoucherStatus @default(PENDING_PAYMENT)
  recipientEmail    String?
  recipientName     String?
  message           String?
  /// Set when the payment settles: twelve months later.
  expiresAt         DateTime?
  redeemedAt        DateTime?
  redeemedByUserId  String?           @db.Uuid
  redeemedBookingId String?           @unique @db.Uuid
  isDemo            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  buyer             User              @relation("GiftVoucherBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  redeemedBy        User?             @relation("GiftVoucherRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  redeemedBooking   Booking?          @relation(fields: [redeemedBookingId], references: [id], onDelete: SetNull)

  @@index([buyerUserId, createdAt])
}

/// Contract: LoyaltyEntryKind (DV-092).
enum LoyaltyEntryKind {
  WELCOME_BONUS
  REFERRAL_BONUS
  PURCHASE_EARNED
  PURCHASE_REVERSED
  REDEEMED
  REDEMPTION_RELEASED
  ADMIN_ADJUSTMENT
}

/// DV-090. The loyalty club's rates, as data (ADR-008). Exactly one row, id 1.
/// Seeded with the Astroman club's published terms, maintainer decision of
/// 2026-09-15; changing a rate is an UPDATE, not a deploy.
model LoyaltyScheme {
  id                   Int      @id @default(1)
  /// Points earned per 1 GEL of settled payment.
  pointsPerGel         Int
  /// Points that take 1 GEL off a booking.
  pointsPerGelRedeemed Int
  welcomeBonusPoints   Int
  referralBonusPoints  Int
  /// The least a cash booking may cost after points, in minor units.
  minimumPayableMinor  Int
  /// Milestones shown on the way to a tier. They grant nothing.
  progressMarkers      Int[]
  updatedAt            DateTime @updatedAt
}

/// DV-090. A tier, as data. Derived from purchase-earned points only.
model LoyaltyTier {
  code            String @id
  nameEn          String
  nameKa          String
  thresholdPoints Int    @unique
  discountPercent Int
}

/// DV-092. The denormalised balance behind the ledger. `balance` and `tierPoints`
/// are the sums of the ledger's columns, and change only in the transaction that
/// appends the entry.
model LoyaltyAccount {
  userId             String    @id @db.Uuid
  balance            Int       @default(0)
  tierPoints         Int       @default(0)
  tierCode           String
  referralCode       String    @unique
  /// DV-096. Who referred this customer; set at registration and never changed.
  referredByUserId   String?   @db.Uuid
  /// DV-096. When both referral bonuses were granted, on the first paid booking.
  referralRewardedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// DV-092. Append-only. One entry per (user, kind, source): the same event
/// recorded twice writes nothing the second time.
model LoyaltyLedgerEntry {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  kind        LoyaltyEntryKind
  /// Signed change to the balance.
  points      Int
  /// Signed change to tier points: non-zero only for a purchase and its reversal.
  tierPoints  Int              @default(0)
  /// What caused it: a payment, a booking, a referee, an adjustment id.
  sourceRef   String
  bookingId   String?          @db.Uuid
  reason      String?
  actorUserId String?          @db.Uuid
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, sourceRef])
  @@index([userId, createdAt])
}

/// SKIPPED: not sent because it no longer applies. FAILED: ran out of attempts.
enum EmailNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// DV-064. The email outbox. Written in the transaction of the event that causes
/// it; delivered by the realtime service. `payload` carries ids only -- what the
/// email says is read at the moment it is sent, and never a secret.
model EmailNotification {
  id            String                  @id @default(uuid()) @db.Uuid
  userId        String                  @db.Uuid
  kind          EmailNotificationKind
  /// One email per event per recipient; a repeated event writes no second row.
  dedupeKey     String                  @unique
  payload       Json
  status        EmailNotificationStatus @default(PENDING)
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}
