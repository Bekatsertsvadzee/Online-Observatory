      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git commit --date *)",
      "Bash(git commit --amend*)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(gh release create *)",
      "Bash(vercel --prod *)",
      "Bash(railway up *)",
      "Bash(railway deploy *)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(npm run prisma migrate deploy *)"
    ]
  }
}
