{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git worktree list)",
      "Bash(npm run lint *)",
      "Bash(npm test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(npm run contracts:check *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge --squash *)",
      "Bash(npm install *)",
      "Bash(npm add *)",
