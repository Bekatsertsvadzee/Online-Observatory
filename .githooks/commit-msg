#!/bin/sh
# Refuse any commit message that credits a second author.
#
# docs/ENGINEERING.md: "Commits carry one author: the maintainer."
#
# This existed as a rule and was broken once anyway, on fcbc115, which now
# permanently reads with two committers on GitHub. A merged commit's author
# cannot be corrected without rewriting main, so the check has to happen before
# the commit exists rather than after.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks

message_file="$1"

# Comment lines are stripped by git before the message is stored, so a
# Co-Authored-By inside git's own commented help text is not a violation.
body=$(grep -v '^#' "$message_file")

if printf '%s\n' "$body" | grep -qi '^[[:space:]]*Co-Authored-By:'; then
    echo "refusing this commit: the message carries a Co-Authored-By trailer." >&2
    echo >&2
    printf '%s\n' "$body" | grep -i '^[[:space:]]*Co-Authored-By:' >&2
    echo >&2
    echo "docs/ENGINEERING.md: commits carry one author, the maintainer. Remove" >&2
    echo "the line and commit again. This overrides any default attribution" >&2
    echo "added by a tool or a global git config." >&2
    exit 1
fi

# A no-reply address in the body is a tool signing its own name to the work.
if printf '%s\n' "$body" | grep -qiE 'noreply@|no-reply@|Generated with'; then
    echo "refusing this commit: the message credits a tool as a contributor." >&2
    echo >&2
    printf '%s\n' "$body" | grep -iE 'noreply@|no-reply@|Generated with' >&2
    echo >&2
    echo "docs/ENGINEERING.md: commits carry one author, the maintainer." >&2
    exit 1
fi

exit 0
