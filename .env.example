TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_SECONDS=900

# Darkview web application
#
# NODE_ENV is not optional for a working local setup. The API and realtime
# schemas default it to development, but `npm run db:seed` reads it directly and
# refuses to run without it -- deliberately, because the seed writes demo users, a
# demo observatory and a demo device token, and a default here would mean an unset
# variable could put fake telescope data into a real database.
NODE_ENV=development
DATABASE_URL=postgresql://darkview:darkview@localhost:5432/darkview?schema=public
# The database `npm run test:integration` connects to. Kept separate from
# DATABASE_URL because the integration suites truncate every table they touch.
DATABASE_TEST_URL=postgresql://darkview:darkview@localhost:5432/darkview_test
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
# Signs the short-expiry live-view URLs the realtime service hands out (ADR-011).
# Separate from AUTH_SECRET on purpose: one signs sessions, the other signs
# view-only URLs, and a key used for two jobs cannot be rotated for one of them.
STREAM_SIGNING_SECRET=replace-with-at-least-32-random-characters
# How many proxies sit in front of this API. Rate limiting reads X-Forwarded-For
# from the right, this many hops back, because the left of that header is written
# by the caller: trusting it would let one client mint a fresh bucket per request.
# Zero means no address is trusted at all, which is the safe default and also
# turns off the per-address cap on new accounts -- keyed on an unattributed
# actor that cap would be one bucket shared by every customer in the world. Set
# it to the real number once the proxy in front of this is known.
TRUSTED_PROXY_HOPS=0
# Object storage for captures (ADR-012). S3-compatible: AWS S3, Cloudflare R2,
# Backblaze B2 and MinIO are all signed identically, and which one is a maintainer
# choice the code does not wait for.
#
# Both services refuse to start without these -- apps/api in src/instrumentation.ts
# and apps/realtime before it accepts a socket. A Collection whose every download
# is broken is worse than a server that says why it will not come up.
#
# The values below are placeholders and are not credentials: nothing signed with
# them is accepted by any real endpoint.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=darkview-captures
S3_ACCESS_KEY_ID=replace-with-the-bucket-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-the-bucket-secret-access-key
# MinIO wants true; AWS S3 wants false and refuses path style on buckets created
# since 2020.
S3_FORCE_PATH_STYLE=true
EMAIL_VERIFICATION_WEBHOOK_URL=
EMAIL_VERIFICATION_WEBHOOK_SECRET=
# Signs the sandbox payment provider's callbacks to POST /payments/webhook
# (DV-056): hex HMAC-SHA256 over the exact request body, presented in
# X-Darkview-Payment-Signature. The sandbox is the development and CI provider
# and is refused outright in production, so this is never a production secret.
# Unset, a SANDBOX callback is refused rather than accepted unsigned.
PAYMENT_SANDBOX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
